dc_shell> proc get_instance_count {} {
    # Step 1: Get all instances where "is_hierarchical == false"
    set instances [get_cells -filter "is_hierarchical==false"]
    # Step 2: Get a list of all the ref_name attributes for these instances
    set ref_name_list {}
    foreach inst $instances {
        lappend ref_name_list [get_attribute $inst ref_name]
    }
    # Step 3: Sort and get unique ref_name values
    set unique_ref_names [lsort -unique $ref_name_list]
    # Step 4: Loop through each unique ref_name and count occurrences
    foreach ref_name $unique_ref_names {
        set count 0
        foreach inst $instances {
            if {[get_attribute $inst ref_name] == $ref_name} {
                incr count
            }
        }
        # Step 5: Print ref_name and count
        puts "Reference Name: $ref_name | Instance Count: $count"
    }
}
